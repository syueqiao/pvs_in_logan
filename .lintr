linters: linters_with_defaults(
  line_length_linter = NULL,        # Disable line length checks
  cyclocomp_linter = NULL,          # Disable complexity checks
  object_name_linter = NULL,        # Disable naming style checks
  object_usage_linter = NULL,       # Disable unused variable checks
  commented_code_linter = NULL,     # Allow commented code
  assignment_linter = NULL,         # Allow both = and <-
  infix_spaces_linter = NULL,       # Don't enforce spacing around operators
  spaces_left_parentheses_linter = NULL,  # Allow flexible spacing
  trailing_whitespace_linter = NULL,      # Allow trailing whitespace
  pipe_call_linter = NULL,          # Allow both %>% and |>
  brace_linter = NULL,              # Flexible brace styling
  commas_linter = NULL,             # Flexible comma spacing
  implicit_integer_linter = NULL,   # Allow 1 instead of 1L
  seq_linter = NULL,
  semicolon_linter = NULL,
  T_and_F_symbol_linter = NULL      # Allow T and F (optional - keep for correctness)
)
